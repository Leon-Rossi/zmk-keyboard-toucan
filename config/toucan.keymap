#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#include "swiss_de.h"

// Layer numbers

#define BASE        0
#define NUMBERS     1
#define AEOUE       2
#define ARROWS      3
#define SYMBOLS     4
#define GAMING      5


// Custom behaviors

&mt {
    tapping-term-ms = <200>;
};

/ {
    behaviors {

        /*
         * Home-row mods
         */

        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions =
                <6 7 8 9 10 11
                 18 19 20 21 22 23
                 30 31 32 33 34 35
                 39 40 41>;

            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;

            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <125>;

            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions =
                <0 1 2 3 4 5
                 12 13 14 15 16 17
                 24 25 26 27 28 29
                 36 37 38>;

            hold-trigger-on-release;
        };


        /*
         * Shift + Space -> Tab
         */

        shift_space: shift_space {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            bindings = <&kp SPACE>, <&kp TAB>;

            mods = <MOD_LSFT>;
        };


        /*
         * Shift + ; -> :
         */

        shift_semicolon: shift_semicolon {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            bindings = <&kp CH_SCLN>, <&kp CH_COLN>;

            mods = <MOD_LSFT>;
        };


        /*
         * Ctrl + Y -> Ctrl + Z
         *
         * For now, use a simple mod-morph.
         *
         * The held Ctrl is preserved by the keyboard's modifier state,
         * so Ctrl+Y becomes Ctrl+Z.
         */

        ctrl_y_undo: ctrl_y_undo {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;

            bindings = <&kp CH_Y>, <&kp CH_Z>;

            mods = <MOD_LCTL>;
        };
    };


    /*
     * Combos
     */

    combos {

        compatible = "zmk,combos";

        combo_df_arrows {
            timeout-ms = <50>;
            key-positions = <15 16>;
            bindings = <&mo ARROWS>;
        };

        combo_jk_aeoue {
            timeout-ms = <50>;
            key-positions = <19 20>;
            bindings = <&mo AEOUE>;
        };

        combo_sd_gui {
            timeout-ms = <50>;
            key-positions = <14 15>;
            bindings = <&kp LGUI>;
        };

        combo_kl_gui {
            timeout-ms = <50>;
            key-positions = <20 21>;
            bindings = <&kp LGUI>;
        };
    };



    // Keymap

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none   &kp Q &kp W &kp E &kp R &kp T        &kp Z &kp U &kp I    &kp O   &kp P   &tog GAMING
                &kp ESC &kp A &kp S &hml LALT D &hml LCTRL F  &kp G &kp H &hmr LCTRL J &hmr LALT K &kp L &shift_semicolon &none
                &none   &ctrl_y_undo &kp X &kp C &kp V &kp B    &kp N &kp M &kp COMMA &kp DOT &kp LS(N7) &tog GAMING
                                          &mo NUMBERS &kp LSHIFT &kp BACKSPACE          &mo SYMBOLS &shift_space &kp ENTER
            >;
        };

        numbers {
            display-name = "NUMBERS";
            bindings = <
                &none  &none &none &none &none &none                         &kp RA(N7) &kp LS(N6) &kp RA(N3) &kp LS(GRAVE) &kp GRAVE &none
                &none  &kp N1 &kp N2 &kp N3 &kp N4 &kp N5                   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &none
                &none  &kp LS(N1) &kp SLASH &kp LS(N3) &kp LS(N7) &kp LS(N0)   &kp LS(QUOTE) &kp LS(RBRC) &kp COMMA &kp DOT &none &none
                                          &trans &kp LSHIFT &kp BACKSPACE                       &kp TAB &kp SPACE &kp ENTER
            >;
        };

        aeoue {
            display-name = "ÄÖÜ";
            bindings = <
                &bt BT_CLR_ALL  &bt BT_CLR &none &none &bt BT_NXT  &none                         &none &none &none &none &none &none
                &none  &kp LS(N2) &kp LBRC &kp SEMICOLON &kp QUOTE      &none &none &trans &trans &none &none &none
                &none  &bt BT_DISC 0 &bt BT_DISC 1 &bt BT_DISC 2 &bt BT_DISC 3 &bt BT_DISC 4    &none &none &none &none &none &none
                            &none &kp LSHIFT &kp LCTRL                          &kp LALT &kp SPACE &kp RALT
            >;
        };

        arrows {
            display-name = "ARROWS";
            bindings = <
                &none  &none &none &none &none &none            &kp RA(N2) &none &none &none &none &none
                &none  &none &kp TAB &trans &trans &none        &kp LEFT &kp DOWN &kp UP &kp RIGHT &kp TAB &none
                &none  &none &none &none &none &none            &none &none &none &none &none &none
                            &none &kp LSHIFT &kp LCTRL              &kp LALT &kp SPACE &kp RALT
            >;
        };

        symbols {
            display-name = "SYMBOLS";
            bindings = <
                &none  &kp RA(EQUAL) &kp RA(NUBS) &kp RA(N2) &kp LS(N5) &kp GRAVE    &none &none &none &none &none &none
                &none  &kp NUBS &kp RA(LBRC) &kp RA(QUOTE) &kp LS(N8) &kp LS(N2)      &kp MINUS &kp LS(N9) &kp RA(NUHS) &kp RA(RBRC) &kp LS(NUBS) &none
                &none  &none &kp LS(MINUS) &none &none &none                              &none &none &none &none &none &none
                                &kp TAB &kp LSHIFT &kp LCTRL                                  &trans &kp SPACE &none
            >;
        };

        gaming {
            display-name = "GAMING";
            bindings = <
                &kp ESC &kp Q &kp W &kp E &kp R &kp T   &kp Z &kp U &kp I &kp O &kp P &trans
                &kp TAB &kp A &kp S &kp D &kp F &kp G   &kp H &kp J &kp K &kp L &kp LS(COMMA) &none
                &none &kp Y &kp X &kp C &kp V &kp B     &kp N &kp M &kp COMMA &kp DOT &kp LS(N7) &trans
                                &kp ENTER &kp LSHIFT &kp SPACE            &kp LALT &kp LCTRL &kp ENTER
            >;
        };
    };
};
